rules_version = '2';

// Phase 0. Each person reads and writes only their own user document, and never the fields the
// Functions own: the Last.fm and Spotify connections (set only after a real sign-in swap) and the
// role. Tokens live in users/{uid}/private/*, which no client can touch; the Admin SDK in the
// Functions ignores these rules. Group sets and writing settings are the owner's alone. Pairs,
// sends and the recipient's inbox arrive with their own rules in later phases (SPEC.md, "Data model").
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function serverOwned() { return ['lastfm', 'spotify', 'role']; }

    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && !request.resource.data.keys().hasAny(serverOwned());
      allow update: if owner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOwned());
      allow delete: if false;

      match /private/{doc} {
        allow read, write: if false;
      }

      match /sets/{setId} {
        allow read, write: if owner(uid);
      }

      match /settings/{doc} {
        allow read, write: if owner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
