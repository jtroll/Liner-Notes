<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <queries>
        <!-- Finding the Spotify app (App Remote and the Open in Spotify links). -->
        <package android:name="com.spotify.music" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="spotify" />
        </intent>
        <!-- Custom Tabs, for Last.fm's approval page. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".LinerNotesApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LinerNotes">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.LinerNotes.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Last.fm's approval comes back here, by way of the Hosting page
                 hosting/lastfm-callback/index.html: linernotes://lastfm-callback?token=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="linernotes" android:host="lastfm-callback" />
            </intent-filter>
        </activity>

        <!-- Spotify's sign-in returns to linernotes://spotify-callback. Auth library 5.0.0 no
             longer declares this intent-filter itself, and crashes without it. -->
        <activity
            android:name="com.spotify.sdk.android.auth.browser.RedirectUriReceiverActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="linernotes" android:host="spotify-callback" />
            </intent-filter>
        </activity>
    </application>
</manifest>
