<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only sets the window before the first frame. -->
    <style name="Theme.LinerNotes" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/casing</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.LinerNotes.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/casing</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.LinerNotes</item>
    </style>
</resources>
